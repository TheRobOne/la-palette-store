{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "APP_ENV",
    "DATABASE_URL",
    "DB_HOST",
    "DB_PORT",
    "DB_USERNAME",
    "DB_PASSWORD",
    "MEDUSA_BACKEND_URL",
    "STORE_CORS",
    "ADMIN_CORS",
    "AUTH_CORS",
    "JWT_SECRET",
    "COOKIE_SECRET",
    "ADMIN_EMAIL",
    "ADMIN_PASSWORD",
    "MEDUSA_WORKER_MODE",
    "DISABLE_MEDUSA_ADMIN",
    "ALLOW_INDEXING"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".medusa/server/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "test": {
      "outputs": []
    },
    "test:unit": {
      "outputs": []
    },
    "seed": {
      "outputs": []
    }
  }
}
