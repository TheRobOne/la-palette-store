# Copy this file to .env (pnpm bootstrap does this for you) and fill in the
# values below. See specs/001-project-skeleton/contracts/configuration.md.

# local | staging | production
APP_ENV=local

# Railway dev Postgres public connection string — never the staging database.
# Build it from the "dev" environment's Postgres service (public TCP proxy).
DATABASE_URL=

# Same Railway dev Postgres, split into parts — used only by integration
# tests (pnpm test:integration), which connect directly with pg.
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=

MEDUSA_BACKEND_URL=http://localhost:9000
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:8000,http://localhost:9000

JWT_SECRET=local-jwt-secret
COOKIE_SECRET=local-cookie-secret

# Required only when APP_ENV is not "local" (FR-004a).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# shared | worker | server — staging uses "shared" (research R-03).
MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=false

# Blocks search-engine indexing (clarification: staging is public, not indexed).
ALLOW_INDEXING=false
